# Local-only convenience. Vite embeds this value in the browser bundle.
# Prefer the in-app session key form for any shared or deployed frontend.
VITE_FINNHUB_API_KEY=
VITE_TWELVE_DATA_API_KEY=
VITE_MARKET_API_WS_URL=ws://localhost:8080/ws/v1/market

# Research store. The Recommendations page reads the published XLK research
# document directly from Supabase through the read-only
# public_research_signal_latest view (migrations/V009). The anon key is a
# publishable credential and is meant to be in the bundle: the only thing it can
# reach is the two views granted in V009. Never put the service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
