FINNHUB_API_KEY=
NEWS_POLL_INTERVAL_SECONDS=900
NEWS_POLL_LOOKBACK_DAYS=3
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=market_data
POSTGRES_USER=market_app
# Local Compose-only default. Override this with a generated secret outside source control.
POSTGRES_PASSWORD=arrakis-local-dev-only
POSTGRES_SSLMODE=disable
SUPABASE_DB_URL=
MARKET_API_PORT=8080
MARKET_RAW_TOPIC=market.raw.trades
MARKET_API_CONSUMER_GROUP=market-api-live-v1
ARRAKIS_ETF_UNIVERSE=config/etf_universe.json
MARKET_UI_API_BASE_URL=http://localhost:8080
# Must exactly match the browser origin. The Compose UI is served on localhost:3000.
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_ENV=development
LOG_LEVEL=info
ARRAKIS_XLK_NEWS_MODEL_PATH=artifacts/xlk_news_xgboost.json
# Keep false until a target clears the documented multi-window validation bar.
ARRAKIS_XLK_NEWS_MODEL_VALIDATED=false
ARRAKIS_XLK_NEWS_FEATURE_COUNT=36
ARRAKIS_FINBERT_ONNX_PATH=models/finbert/model.onnx
ARRAKIS_FINBERT_VOCAB_PATH=models/finbert/vocab.txt
ARRAKIS_FINBERT_VERSION=finbert-v1
ARRAKIS_FINBERT_TOKENIZER_VERSION=finbert-tokenizer-v1
ARRAKIS_FINBERT_MAX_TOKENS=128
ARRAKIS_FEATURE_SCHEMA_HASH=xlk-combined-features-v1
# Used only by scripts/fetch_finbert_model.sh; publish the exact Arrakis export at a versioned URL.
ARRAKIS_FINBERT_MODEL_URL=
ARRAKIS_FINBERT_VOCAB_URL=
NEWS_PREDICTION_CUTOFF_UNIX_MS=
NEWS_PREDICTION_CUTOFF_ISO=
NEWS_TRADING_DATE=
